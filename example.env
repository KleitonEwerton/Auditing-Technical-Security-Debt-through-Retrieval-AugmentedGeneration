GROQ_API_KEY=your_groq_api_key_here

# Modelo LLM utilizado nos pipelines 02_* e 05_reprocessar_resultados.py
# Modelo usado nos experimentos originais do artigo (depreciado em 16/ago/2026):
#   GROQ_LLM_MODEL=llama-3.3-70b-versatile
# Alternativas recomendadas pela Groq após depreciação:
#   GROQ_LLM_MODEL=openai/gpt-oss-120b    (substituto recomendado)
#   GROQ_LLM_MODEL=qwen/qwen3.6-27b       (alternativa de menor custo)
# Ref: https://console.groq.com/docs/deprecations#august-16-2026-llama318binstant-and-llama3370bversatile
GROQ_LLM_MODEL=openai/gpt-oss-120b

# Rate limit controls (adjust according to your Groq plan/key limits)
# Used by 02_retreinar_stride.py and 02_retreinar_stride_baseline.py
RATE_LIMIT_PAUSA_ENTRE_REQUISICOES=2
RATE_LIMIT_REQUISICOES_POR_LOTE=10
RATE_LIMIT_PAUSA_LOTE=10

# Quota backoff: behavior when the API returns a rate-limit / 429 error.
# RATE_LIMIT_QUOTA_WAIT    – seconds to wait before retrying after a quota error (default: 60)
# RATE_LIMIT_QUOTA_MAX_RETRIES – max automatic retries per request before recording as failure (default: 3)
# After all retries are exhausted the case is saved with an "erro" field so it can be
# retried selectively on the next run (the script will prompt you to resume).
RATE_LIMIT_QUOTA_WAIT=60
RATE_LIMIT_QUOTA_MAX_RETRIES=3

# Optional override used by 05_reprocessar_resultados.py
# If omitted, it reuses RATE_LIMIT_PAUSA_ENTRE_REQUISICOES
RATE_LIMIT_REPROCESSAR_PAUSA_ENTRE_REQUISICOES=2